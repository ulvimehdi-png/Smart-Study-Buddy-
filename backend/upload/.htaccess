Options -Indexes -ExecCGI

<FilesMatch "\.(php|phtml|phar|php[0-9]?|cgi|pl|py|sh|shtml)$">
    Require all denied
</FilesMatch>

<IfModule mod_php.c>
    php_flag engine off
</IfModule>

RemoveHandler .php .phtml .phar .php3 .php4 .php5 .php7 .php8
RemoveType .php .phtml .phar .php3 .php4 .php5 .php7 .php8
