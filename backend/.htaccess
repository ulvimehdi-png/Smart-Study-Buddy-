RewriteEngine On

#
# HARD BLOCK SOURCE / INTERNAL PATHS
#
RewriteRule ^(bin|config|migrations|src|var|vendor)(/|$) - [F,L]

<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<FilesMatch "(composer\.json|composer\.lock|symfony\.lock)">
    Require all denied
</FilesMatch>

#
# TOP-LEVEL UPLOADS
#
RewriteRule ^upload(/|$) - [L]


#
# EVERYTHING ELSE -> public/
# /api/... becomes /public/api/... and is then handled by public/.htaccess
#
RewriteRule ^(.*)$ public/$1 [L]
